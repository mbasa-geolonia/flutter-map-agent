abstract final class AppConfig {
  /// Anthropic Claude API key.
  static const String anthropicApiKey =
      'ANTHROPIC_API_KEY';

  /// OpenAI API key.
  static const String openAiApiKey =
      'OPENAI_API_KEY';

  /// MapFan tile API key.
  static const String mapfanApiKey =
      'MAPFAN_API_KEY';

  /// MCP server URL (Streamable HTTP transport).
  static const String mcpServerUrl = 'http://localhost:8888/mcp';

  /// Per-user MCP API key, sent as `Authorization: Bearer <mcpApiKey>`.
  /// Issue one on the MCP server with:
  ///   ./manage_keys.py issue --user <you> --label <device>
  static const String mcpApiKey = 'MCP_API_KEY';
}
